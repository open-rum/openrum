# Copy to .env.production, set chmod 600, and fill every required value before
# running the production Compose file. Use a DNS name pointing at this host.
OPENRUM_DOMAIN=
OPENRUM_IMAGE=openrum-production:local

# Generate each value independently with: openssl rand -hex 24
# Hex avoids URL-encoding problems in the PostgreSQL/ClickHouse DSNs.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
BOOTSTRAP_TOKEN=

# This exact private address is assigned to Caddy by production.compose.yml.
# Change both values together if this subnet overlaps your host network.
OPENRUM_EDGE_SUBNET=172.30.77.0/24
OPENRUM_EDGE_IP=172.30.77.10

# Tune against measured ingest volume and the capacity guide.
OPENRUM_KAFKA_RETENTION_DURATION=168h
OPENRUM_CONSUMER_WORKERS=4
OPENRUM_CONSUMER_FLUSH_INTERVAL=10ms

# The bundled ClickHouse runs on the same host, so retain the disk-pressure guard.
OPENRUM_STORAGE_PRESSURE_GUARD_ENABLED=true
OPENRUM_STORAGE_WARNING_FREE_RATIO=0.15
OPENRUM_STORAGE_CRITICAL_FREE_RATIO=0.10
OPENRUM_STORAGE_HARD_STOP_FREE_RATIO=0.05
OPENRUM_STORAGE_RECOVERY_FREE_RATIO=0.10
OPENRUM_STORAGE_EMERGENCY_SAMPLE_RATE=0.10
OPENRUM_STORAGE_POLL_INTERVAL=30s

# Optional Source Map artifact storage. Leave all fields empty when unused.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_FORCE_PATH_STYLE=
OPENRUM_OBJECT_STORAGE_ENDPOINT_ALLOWLIST=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Console-managed object-storage and alert-channel credentials.
# If enabled, generate with: openssl rand -base64 32
OPENRUM_ALLOW_MANAGED_SECRETS=false
OPENRUM_MASTER_KEY=
OPENRUM_MASTER_KEY_ID=v1
