POSTGRES_DB=openrum
POSTGRES_USER=openrum
POSTGRES_PASSWORD=openrum_local_only
POSTGRES_PORT=5433
CONSOLE_PORT=4173

CLICKHOUSE_DB=openrum
CLICKHOUSE_USER=openrum
CLICKHOUSE_PASSWORD=openrum_local_only
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

KAFKA_PORT=9092
REDIS_PORT=6379
OPENRUM_KAFKA_RETENTION_DURATION=168h
# Consumer readers share the ClickHouse batch writer. Benchmark before raising;
# active readers cannot exceed the event topic's partition count.
OPENRUM_CONSUMER_WORKERS=4
# Wait at most this long to fill a batch (1ms..1s). Larger windows trade
# low-volume freshness for fewer, larger ClickHouse inserts.
OPENRUM_CONSUMER_FLUSH_INTERVAL=10ms

# Optional ClickHouse disk-pressure guard. When enabled, free space below the
# critical ratio temporarily caps Browser SDK sampling until recovery.
OPENRUM_STORAGE_PRESSURE_GUARD_ENABLED=true
OPENRUM_STORAGE_WARNING_FREE_RATIO=0.15
OPENRUM_STORAGE_CRITICAL_FREE_RATIO=0.10
OPENRUM_STORAGE_HARD_STOP_FREE_RATIO=0.05
OPENRUM_STORAGE_RECOVERY_FREE_RATIO=0.10
OPENRUM_STORAGE_EMERGENCY_SAMPLE_RATE=0.10
OPENRUM_STORAGE_POLL_INTERVAL=30s

# Object storage is optional. Leave the provider empty to run the complete core
# monitoring product without Source Map artifacts or future replay blobs.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_FORCE_PATH_STYLE=
# Exact custom hosts allowed in production, comma-separated.
OPENRUM_OBJECT_STORAGE_ENDPOINT_ALLOWLIST=

# Alibaba OSS credentials are optional when ECS/ACK has a RAM Role.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# S3-compatible credentials are optional when an AWS workload role is available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional console-managed object-storage credentials. Keep disabled when using
# RAM/IAM roles or deployment-managed Secret values. Generate the master key
# with: openssl rand -base64 32
OPENRUM_ALLOW_MANAGED_SECRETS=false
OPENRUM_MASTER_KEY=
OPENRUM_MASTER_KEY_ID=v1
