---
import DesignLayout from "../../layouts/DesignLayout.astro";
import DesignSection from "../../components/design/DesignSection.astro";
import BrandMark from "../../components/BrandMark.astro";
import BrandWordmark from "../../components/BrandWordmark.astro";
import ChartExamples from "../../components/design/ChartExamples";
import FontPreview from "../../components/design/FontPreview.astro";
import { ArrowUpRight, Download, Copy, Check, ArrowRight } from "lucide-astro";
import {
  cardHues,
  cardRoles,
  colorGroups,
  densities,
  palettes,
  typeSamples,
} from "@openrum/design-tokens/catalog";
const spaces = [
  ["--space-1", "04"],
  ["--space-2", "08"],
  ["--space-3", "12"],
  ["--space-4", "16"],
  ["--space-6", "24"],
  ["--space-8", "32"],
  ["--space-12", "48"],
  ["--space-16", "64"],
];
---

<DesignLayout>
  <div class="ds-intro">
    <div>
      <p class="ds-overline">OPENRUM / VISUAL FOUNDATIONS</p><h1>
        设计规范<span>Design system.</span>
      </h1><p class="ds-intro-copy">
        从品牌标识到每一条数据曲线。<br />在这里查看三套配色、四色色卡、两种密度与页面效果。
      </p>
    </div><div class="ds-intro-mark"><BrandMark size={112} /></div>
  </div>
  <div class="ds-summary">
    <span><strong>01</strong> 三套配色</span><span><strong>02</strong> 明暗模式</span><span
      ><strong>03</strong> 两种密度</span
    ><span class="ds-summary-live"><i class="ds-status-dot"></i> 与共享 token 同步</span>
  </div>

  <DesignSection
    id="brand"
    index="01"
    title="品牌标识"
    description="控制台、网站和文档共用像素信号小怪，支持短暂的眨眼、挥手和信号闪动。标记跟随当前配色，favicon 使用默认的琥珀色；字标保持中性文字色。"
  >
    <div class="ds-brand-board">
      <div class="ds-brand-lockup">
        <span class="brand-mark" data-brand-download><BrandMark size={88} /></span><BrandWordmark />
      </div><span class="ds-board-caption">PRIMARY LOCKUP / SVG</span><button
        class="ds-text-button"
        data-download-logo><Download size={15} />下载当前配色 SVG</button
      >
    </div>
    <div class="ds-logo-variants">
      <div>
        <div class="ds-logo-sample brand-mark"><BrandMark size={46} /></div><span
          >图标 · 40px 推荐</span
        >
      </div>
      <div>
        <div class="ds-logo-sample" data-theme-scope="light"><BrandMark size={46} /></div><span
          >当前配色 · 亮色表面</span
        >
      </div>
      <div>
        <div class="ds-logo-sample dark"><BrandMark size={46} /></div><span
          >当前配色 · 深色表面</span
        >
      </div>
      <div>
        <div class="ds-logo-sample ds-clearspace">
          <span><BrandMark size={42} /></span><small>¼ x</small>
        </div><span>安全留白 · 至少 ¼ 标记宽度</span>
      </div>
    </div>
  </DesignSection>

  <DesignSection
    id="palettes"
    index="02"
    title="配色"
    description="默认琥珀，可切换柠檬绿和品红。选中的颜色成为主色，色卡里其余三色作为点缀。切换立即作用于本页、官网与文档；控制台在账户菜单里单独选择。"
  >
    <fieldset class="ds-presets" role="radiogroup" aria-label="配色">
      <legend class="sr-only">配色</legend>
      {
        palettes.map((palette, index) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            class="ds-preset ds-palette-card"
            data-palette-option={palette.id}
          >
            <span class="ds-preset-top">
              <small>
                0{index + 1} / {palette.label}
              </small>
              <Check size={15} />
            </span>
            <span class="ds-palette-dots" aria-hidden="true">
              {palette.dots.map((hue) => (
                <i style={`background:var(--ds-${hue}-solid)`} />
              ))}
            </span>
            <strong>{palette.name}</strong>
            <p>{palette.description}</p>
          </button>
        ))
      }
    </fieldset>
    <div class="ds-guidance">
      <span>色卡规则</span><p>
        琥珀、柠檬绿、天蓝、品红组成四色色卡。主色只用于
        Logo、选中、焦点、开关、进度与第一数据系列；点缀色用于徽标、分类标签和第二到第四数据系列。主要操作保持黑白对比，不用品牌色填充；上一周期是中性灰虚线；警告状态用橙色，与琥珀主色区分。
      </p>
    </div>
    <div class="ds-color-contract">
      <h3>页面用色规则</h3>
      <dl>
        <div>
          <dt>标题与数值</dt><dd>
            标题、KPI、表格主体使用 <code>--ds-text</code
            >。数值大小不决定颜色；状态通过旁边的文字与徽标表达。
          </dd>
        </div>
        <div>
          <dt>标签与说明</dt><dd>
            字段、图例使用 <code>--ds-text-secondary</code>；说明、时间、坐标轴使用 <code
              >--ds-text-muted</code
            >。图例只给色点着色。
          </dd>
        </div>
        <div>
          <dt>导航与控件</dt><dd>
            选中导航用 <code>--ds-sidebar-accent</code> 浅灰背景和中性文字；选中的表单选项用 <code
              >--ds-selection</code
            > 与主色描边。主操作亮色黑底、暗色白底。
          </dd>
        </div>
        <div>
          <dt>状态反馈</dt><dd>
            成功、警告、错误分别使用
            Success、Warning、Danger，配文字或图标。点缀色只表达分类，不表达好坏。
          </dd>
        </div>
      </dl>
    </div>
  </DesignSection>

  <DesignSection
    id="card"
    index="03"
    title="四色色卡"
    description="每个色相有实心、浅底、可读文字和描边四种角色；亮色与暗色各一套，文字对比度都不低于 4.5:1。"
  >
    <div class="ds-card-grid">
      {
        cardHues.map((hue) => (
          <div class="ds-card-hue">
            <h3>
              {hue.label} <span>{hue.name}</span>
            </h3>
            {cardRoles.map(([role, usage]) => (
              <button
                class="ds-swatch"
                data-copy-token={`--ds-${hue.id}-${role}`}
                aria-label={`复制 --ds-${hue.id}-${role}`}
              >
                <span class="ds-swatch-paint" style={`background:var(--ds-${hue.id}-${role})`} />
                <span class="ds-swatch-title">
                  {usage}
                  <Copy size={13} />
                </span>
                <span
                  class="ds-swatch-value"
                  data-token-value={`--ds-${hue.id}-${role}`}
                  data-token-format="color"
                />
                <code>{`--ds-${hue.id}-${role}`}</code>
              </button>
            ))}
          </div>
        ))
      }
    </div>
    <div class="ds-badge-row" aria-label="徽标示例">
      <span
        class="ds-badge"
        style="background:var(--ds-primary-soft);color:var(--ds-primary-ink);border-color:var(--ds-primary-border)"
        >品牌 · 随配色</span
      >
      {
        cardHues.map((hue) => (
          <span
            class="ds-badge"
            style={`background:var(--ds-${hue.id}-soft);color:var(--ds-${hue.id}-ink);border-color:var(--ds-${hue.id}-border)`}
          >
            {hue.label}
          </span>
        ))
      }
    </div>
  </DesignSection>

  <DesignSection
    id="colors"
    index="04"
    title="语义颜色"
    description="颜色以用途命名。点击色卡复制 CSS 变量；数值读取当前主题，并随明暗模式实时更新。"
  >
    {
      colorGroups.map((group) => (
        <div class="ds-color-group">
          <>
            <div class="ds-subhead">
              <>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </>
            </div>
            <div class="ds-swatch-grid">
              {group.tokens.map(([token, title, usage]) => (
                <button class="ds-swatch" data-copy-token={token} aria-label={`复制 ${token}`}>
                  <span class="ds-swatch-paint" style={`background:var(${token})`} />
                  <span class="ds-swatch-title">
                    {title}
                    <Copy size={13} />
                  </span>
                  <span
                    class="ds-swatch-value"
                    data-token-value={token}
                    data-token-format="color"
                  />
                  <code>{token}</code>
                  <small>{usage}</small>
                </button>
              ))}
            </div>
          </>
        </div>
      ))
    }
  </DesignSection>

  <DesignSection
    id="typography"
    index="05"
    title="字体与排版"
    description="比较五款候选字体，分别选择英文与中文，观察正文、KPI、表格和图表的效果。当前产品使用 IBM Plex Sans + 系统黑体；以下候选可用于本页对比预览。"
  >
    <FontPreview />
    <div class="ds-type-specimens">
      {
        typeSamples.map((sample) => (
          <div class="ds-type-row">
            <>
              <div>
                <>
                  <b>{sample.name}</b>
                  <span>{sample.detail}</span>
                </>
              </div>
              <p style={`font-size:var(${sample.size});font-weight:${sample.weight}`}>
                {sample.text}
              </p>
            </>
          </div>
        ))
      }
    </div>
    <div class="ds-code-sample">
      <span>CODE / MONOSPACE</span><code>{"captureException(error, { release: '1.0.0' })"}</code
      ><small>堆栈、事件标识与数值对齐使用等宽字体。</small>
    </div>
  </DesignSection>

  <DesignSection
    id="foundations"
    index="06"
    title="空间与质感"
    description="Maia 圆角体系：按钮与单行表单使用胶囊圆角，多行表单、卡片和弹层使用分级大圆角。官网和控制台共享基础。"
  >
    <div class="ds-foundation-grid">
      <div class="ds-material">
        <h3>Spacing scale</h3><div class="ds-spacing-list">
          {
            spaces.map(([token, size]) => (
              <div>
                <>
                  <code>{size}</code>
                  <i style={`width:var(${token})`} />
                  <span>{token}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
      <div class="ds-material">
        <h3>Radius & elevation</h3><div class="ds-radius-list">
          {
            ["control", "field", "surface", "overlay"].map((size) => (
              <div>
                <>
                  <i style={`border-radius:var(--radius-${size})`} />
                  <code data-token-value={`--radius-${size}`} />
                  <span>{size}</span>
                </>
              </div>
            ))
          }
        </div><div class="ds-elevations">
          <span>Surface</span><span>Elevated</span><span>Frosted</span>
        </div><p>阴影只用于需要抬升的菜单与控件。导航保留磨砂，内容面板使用实色表面。</p>
      </div>
    </div>
    <div class="ds-interactions">
      <div><h3>Interaction</h3><p>轻微位移，清晰焦点。状态变化不改变布局。</p></div><button
        class="ui-button ui-button-contrast ds-hover-demo"
        >Hover / Focus<ArrowRight size={16} /></button
      ><button class="ui-button ui-button-neutral" disabled>Disabled</button>
    </div>
  </DesignSection>

  <DesignSection
    id="density"
    index="07"
    title="布局密度"
    description="控制台提供舒适和紧凑两种密度，由用户在账户菜单里选择。紧凑模式缩小控件、表格行和页面间距，文字不小于 12px，触屏设备仍保持 44px 点击区域。"
  >
    <div class="ds-density-grid">
      {
        densities.map((density) => (
          <div class="ds-density-panel" data-density={density.id}>
            <div class="ds-density-head">
              <strong>{density.label}</strong>
              <small>{density.description}</small>
            </div>
            <div class="ds-density-controls">
              <span class="ds-density-button ds-density-button--primary">保存规则</span>
              <span class="ds-density-button">取消</span>
              <span class="ds-density-input">搜索页面…</span>
            </div>
            <div class="ds-density-table" role="table" aria-label={`${density.label}密度表格示例`}>
              <div role="row" class="ds-density-row ds-density-row--head">
                <span role="columnheader">页面</span>
                <span role="columnheader">PV</span>
                <span role="columnheader">错误率</span>
              </div>
              {[
                ["/checkout", "12,480", "0.8%"],
                ["/product", "9,221", "0.3%"],
                ["/search", "6,907", "0.1%"],
              ].map(([page, views, rate]) => (
                <div role="row" class="ds-density-row">
                  <span role="cell">{page}</span>
                  <span role="cell">{views}</span>
                  <span role="cell">{rate}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </DesignSection>

  <DesignSection
    id="charts"
    index="08"
    title="数据可视化"
    description="使用项目现有 shadcn Chart / Recharts 基础。三种常用图表共享同一套语义配色，支持悬停与键盘查看数据。"
  >
    <div class="ds-chart-palette">
      {
        [1, 2, 3, 4, 5].map((index) => (
          <button data-copy-token={`--ds-chart-${index}`} aria-label={`复制图表颜色 ${index}`}>
            <>
              <i style={`background:var(--ds-chart-${index})`} />
              <span>Series 0{index}</span>
              <code data-token-value={`--ds-chart-${index}`} data-token-format="color" />
            </>
          </button>
        ))
      }
    </div>
    <div class="ds-chart-palette">
      <button data-copy-token="--ds-chart-comparison" aria-label="复制周期对比颜色">
        <i style="background:var(--ds-chart-comparison)"></i><span>周期对比</span>
        <code data-token-value="--ds-chart-comparison" data-token-format="color"></code>
      </button>
    </div>
    <ChartExamples client:visible />
    <div class="ds-guidance">
      <span>图表规则</span><p>
        单系列统一用 Chart 1 柠檬绿；不同指标优先用 Chart 2 蓝绿；上一周期用淡黄加虚线。 Chart 3–5
        保留参考主题色阶，其中 Chart 5 与 Chart 1 相同，不作为独立分类的唯一区分。
        柱体与面积可降低透明度，折线保留系列色；轴线、网格和标签使用中性色。
        一个面板只展示一种单位；性能评分柱与仪表使用 Good chart / Warning chart 填充，
        标签和阈值保留较深的状态色。错误仍用 Danger。所有图表均为固定示例数据。
      </p>
    </div>
  </DesignSection>

  <DesignSection
    id="previews"
    index="09"
    title="落地页方案"
    description="保留不同版本，使用相同配色对比布局。方案 1 对应文档，后续方案会继续加入这里。"
  >
    <div class="ds-preview-cards">
      <a class="ds-preview-card" href="/" data-preview-link="/"
        ><div class="ds-mini ds-mini-centered">
          <i></i><span></span><b></b><em></em><div>
            <small></small><small></small><small></small>
          </div>
        </div><div>
          <span>当前首页</span><h3>Centered / Light Rays <ArrowUpRight size={18} /></h3><p>
            居中标题、动态光束与技术栈。
          </p>
        </div></a
      >
      <a class="ds-preview-card" href="/design/landing/01/" data-preview-link="/design/landing/01/"
        ><div class="ds-mini ds-mini-split">
          <section><span></span><b></b><em></em></section><section class="ds-mini-dashboard">
            <i></i><i></i><i></i><svg viewBox="0 0 200 55"
              ><path d="M0 48L18 32L35 39L60 20L86 30L110 13L136 24L164 8L185 13L200 3"></path></svg
            >
          </section>
        </div><div>
          <span>方案 01 · 文档原案</span><h3>Product first <ArrowUpRight size={18} /></h3><p>
            双栏 Hero、产品界面示意与自部署叙事。
          </p>
        </div></a
      >
    </div>
    <a class="ds-compare-link" href="/design/landing/" data-preview-link="/design/landing/"
      >打开方案对比工作台 <ArrowRight size={17} /></a
    >
  </DesignSection>
  <footer class="ds-page-footer">
    <span>OpenRUM Design / Foundations v1</span><a href="/docs/contributing/">参与贡献 ↗</a>
  </footer>
</DesignLayout>
