---
import { Languages, Menu, Moon } from "lucide-astro";
import BrandMark from "./BrandMark.astro";
import BrandWordmark from "./BrandWordmark.astro";
import { docsBase, equivalentPath } from "../lib/site";
const { lang = "en", path = "/" } = Astro.props;
const zh = lang === "zh";
const prefix = zh ? "/zh" : "";
const equivalent = equivalentPath(path, zh ? "zh" : "en");
const links = zh
  ? [["文档", `${docsBase("zh")}/`]]
  : [["Docs", `${docsBase("en")}/`]];
---

<header class="site-header">
  <nav class="site-container site-nav" aria-label={zh ? "公共导航" : "Public navigation"}>
    <a class="site-brand" href={`${prefix}/`} aria-label="OpenRUM"
      ><span class="brand-mark" aria-hidden="true"><BrandMark /></span><BrandWordmark />
    </a><div class="site-links">
      {
        links.map(([label, href]) => (
          <a href={href} aria-current={path === href ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div><div class="site-actions">
      <a
        class="icon-action"
        href={equivalent}
        aria-label={zh ? "Switch to English" : "切换到简体中文"}><Languages size={17} /></a
      ><button
        class="icon-action"
        id="theme-toggle"
        type="button"
        aria-label={zh ? "切换明暗主题" : "Toggle color theme"}><Moon size={17} /></button
      ><details class="mobile-nav">
        <summary class="icon-action" aria-label={zh ? "打开导航" : "Open navigation"}
          ><Menu size={18} /></summary
        ><div class="mobile-nav-panel">
          {
            links.map(([label, href]) => (
              <a href={href} aria-current={path === href ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>
<script is:inline>
  document.querySelector("#theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    document.documentElement.dataset.theme = dark ? "dark" : "light";
    document.documentElement.style.colorScheme = dark ? "dark" : "light";
    const url = new URL(location.href);
    if (url.searchParams.has("theme")) {
      url.searchParams.set("theme", dark ? "dark" : "light");
      history.replaceState(null, "", url);
    }
    try {
      localStorage.setItem("openrum-theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
