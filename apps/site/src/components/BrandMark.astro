---
import { signalScoutBodyPath, signalScoutEyePath } from "../lib/siteBrand";
const { size = 28 } = Astro.props;
---

<svg
  style="color:var(--ds-logo)"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <path d={signalScoutBodyPath} fill="currentColor"></path>
  <path d={signalScoutEyePath} fill="#262723"></path>
</svg>
