---
import {
  Activity,
  Bell,
  Bug,
  ChartNoAxesCombined,
  Gauge,
  Globe2,
  Search,
  Waypoints,
} from "lucide-astro";
import PublicLayout from "../layouts/PublicLayout.astro";
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const items = zh
  ? [
      ["分析", "核心", "PV/UV、来源、地域、设备、浏览器、自定义事件、漏斗、路径与留存。", Globe2],
      ["错误", "核心", "JavaScript 自动捕获、Issue 分组、影响用户、Session 与 Source Map。", Bug],
      ["会话", "核心", "按用户、页面、错误和自定义属性筛选完整活动窗口。", Waypoints],
      ["性能", "辅助证据", "Web Vitals、Route 评分、分布和慢样本。", Gauge],
      ["事件", "统一模型", "事件目录、趋势、属性与用户时间线。", Activity],
      ["API", "辅助证据", "浏览器请求量、失败率、延迟、Endpoint 与样本。", ChartNoAxesCombined],
      ["告警", "已实现", "质量规则、通知状态和带过滤条件的调查链接。", Bell],
      ["洞察", "演进中", "用可解释证据呈现跨行为、错误、性能和 API 的变化。", Search],
    ]
  : [
      [
        "Analysis",
        "Core",
        "PV/UV, acquisition, geography, device, browser, Custom Events, funnels, paths and retention.",
        Globe2,
      ],
      [
        "Errors",
        "Core",
        "Automatic JavaScript capture, Issue grouping, affected users, Sessions and Source Maps.",
        Bug,
      ],
      [
        "Sessions",
        "Core",
        "Filter complete activity windows by user, page, error and custom attributes.",
        Waypoints,
      ],
      [
        "Performance",
        "Supporting evidence",
        "Web Vitals, Route scores, distributions and slow samples.",
        Gauge,
      ],
      [
        "Events",
        "Unified model",
        "Event catalog, trends, properties and user timelines.",
        Activity,
      ],
      [
        "API",
        "Supporting evidence",
        "Browser request volume, failure rate, latency, Endpoint and samples.",
        ChartNoAxesCombined,
      ],
      [
        "Alerts",
        "Implemented",
        "Quality rules, delivery state and investigation links with filters.",
        Bell,
      ],
      [
        "Insights",
        "Evolving",
        "Explain changes across behavior, errors, performance and APIs with visible evidence.",
        Search,
      ],
    ];
---

<PublicLayout
  title={zh ? "产品能力 — OpenRUM" : "Product capabilities — OpenRUM"}
  description={zh
    ? "OpenRUM 已实现能力、边界与统一调查路径。"
    : "Implemented OpenRUM capabilities, boundaries and investigation workflow."}
  lang={lang}
>
  <section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Product · Alpha</p><h1>
        {
          zh
            ? "围绕同一个用户、Session、页面和 Release 调查"
            : "Investigate around one user, Session, page and Release"
        }
      </h1><p>
        {
          zh
            ? "OpenRUM 不把竞品功能表简单相加。核心是行为异常与前端错误之间的双向路径；性能和 API 是解释体验问题的证据。"
            : "OpenRUM does not add competitor feature lists together. Its core is a two-way path between behavior changes and frontend errors; performance and APIs explain the experience."
        }
      </p>
    </div>
  </section>
  <section class="section">
    <div class="site-container">
      <div class="card-grid">
        {
          items.map(([title, status, body, Icon]) => (
            <article class="ui-card feature-card">
              <>
                <span class="feature-icon">
                  <Icon size={19} />
                </span>
                <h3>{title}</h3>
                <p>{body}</p>
                <div class="status-line">
                  <>
                    <span>{status}</span>
                    <a
                      href={zh ? "/zh/docs/product/investigation/" : "/docs/product/investigation/"}
                    >
                      {zh ? "调查指南" : "Investigation guide"} →
                    </a>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PublicLayout>
