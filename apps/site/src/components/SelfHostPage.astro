---
import { Boxes, Cloud, Server, ShieldCheck } from "lucide-astro";
import PublicLayout from "../layouts/PublicLayout.astro";
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const tiers = zh
  ? [
      [
        "本地验证",
        "Docker Compose",
        "一条命令启动完整数据链路与 30,000 个确定性 Session。适合评估，不是生产高可用。",
        Boxes,
      ],
      [
        "单机生产部署",
        "独立的 Docker Compose",
        "一台 Linux 服务器运行完整服务，配置 HTTPS、私有凭据和异机备份；需要接受单点故障。",
        Server,
      ],
      [
        "Kubernetes / Helm",
        "生产部署",
        "应用服务可独立扩缩；需自行准备外部 PostgreSQL、ClickHouse、Kafka、Redis、密钥与备份。",
        Cloud,
      ],
    ]
  : [
      [
        "Local evaluation",
        "Docker Compose",
        "One command starts the data path and 30,000 deterministic Sessions. Good for evaluation, not production HA.",
        Boxes,
      ],
      [
        "Single-host production",
        "Separate Docker Compose stack",
        "Run the complete stack on one Linux server with HTTPS, private credentials and off-host backups; accept the single point of failure.",
        Server,
      ],
      [
        "Kubernetes / Helm",
        "Production deployment",
        "Scale application services independently; prepare external PostgreSQL, ClickHouse, Kafka, Redis, secrets and backups.",
        Cloud,
      ],
    ];
---

<PublicLayout
  title={zh ? "自部署 — OpenRUM" : "Self-host OpenRUM"}
  description={zh ? "在自己的基础设施运行 OpenRUM。" : "Run OpenRUM in your own infrastructure."}
  lang={lang}
  ><section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Self-host</p><h1>
        {
          zh
            ? "数据、保留策略与依赖都由你控制"
            : "Control your data, retention policy and dependencies"
        }
      </h1><p>
        {
          zh
            ? "本地评估、单机生产和推荐的 Kubernetes 部署各有独立路径。OpenRUM 不要求连接托管控制面。"
            : "Choose local evaluation, single-host production or the recommended Kubernetes path. OpenRUM does not require a hosted control plane."
        }
      </p><div class="cta-row">
        <a
          class="ui-button ui-button-primary"
          href={zh ? "/zh/docs/getting-started/quickstart/" : "/docs/getting-started/quickstart/"}
          >{zh ? "本地快速开始" : "Local quickstart"}</a
        ><a
          class="ui-button ui-button-outline"
          href={zh ? "/zh/docs/self-hosting/overview/" : "/docs/self-hosting/overview/"}
          >{zh ? "生产部署文档" : "Production deployment docs"}</a
        >
      </div>
    </div>
  </section><section class="section">
    <div class="site-container">
      <div class="card-grid">
        {
          tiers.map(([title, status, body, Icon], index) => (
            <article
              class:list={["ui-card", "feature-card", { "self-host-recommended": index === 2 }]}
            >
              <>
                {index === 2 && (
                  <span class="self-host-recommended-badge">{zh ? "推荐" : "Recommended"}</span>
                )}
                <span class="feature-icon">
                  <Icon size={19} />
                </span>
                <h3>{title}</h3>
                <p>{body}</p>
                <div class="status-line">
                  <>
                    <span>{status}</span>
                    <span>Alpha</span>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div><div class="ui-card proof-card" style="margin-top:14px">
        <span class="feature-icon"><ShieldCheck size={19} /></span><h3>
          {zh ? "生产前检查" : "Production readiness"}
        </h3><p>
          {
            zh
              ? "接入真实流量前完成 TLS、私有密钥、异机备份与恢复演练、依赖监控、容量验证和升级演练。单机 Docker 不提供高可用；千万级日 PV 是设计目标，不是未经验证的默认承诺。"
              : "Before real traffic, verify TLS, private secrets, off-host backup and restore, dependency monitoring, capacity and upgrades. Single-host Docker is not highly available; ten-million daily PV is a design target, not an unverified default claim."
          }
        </p>
      </div>
    </div>
  </section></PublicLayout
>

<style>
  .self-host-recommended {
    position: relative;
    border-color: var(--ds-primary);
  }

  .self-host-recommended-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--ds-primary);
    border-radius: 999px;
    color: var(--ds-primary-foreground);
    background: var(--ds-primary);
    font-size: 0.75rem;
    font-weight: 650;
  }
</style>
