---
const { manageTheme = false } = Astro.props;
---

<script is:inline define:vars={{ manageTheme }}>
  (() => {
    const params = new URLSearchParams(location.search);
    let storedTheme;
    try {
      storedTheme = localStorage.getItem("openrum-theme");
    } catch {}
    if (params.get("embed") === "1") document.documentElement.dataset.designEmbed = "true";
    if (manageTheme) {
      const requestedTheme = params.get("theme") || storedTheme;
      const mode =
        requestedTheme === "light"
          ? "light"
          : requestedTheme === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : "dark";
      document.documentElement.classList.toggle("dark", mode === "dark");
      document.documentElement.dataset.theme = mode;
      document.documentElement.style.colorScheme = mode;
    }
  })();
</script>
