---
import go from "../../assets/tech/go.svg?raw";
import typescript from "../../assets/tech/typescript.svg?raw";
import react from "../../assets/tech/react.svg?raw";
import clickhouse from "../../assets/tech/clickhouse.svg?raw";
import postgres from "../../assets/tech/postgresql.svg?raw";
import kafka from "../../assets/tech/apachekafka.svg?raw";
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const docs = zh ? "/zh/docs" : "/docs";
const items = [
  { name: "Go", icon: go, href: `${docs}/self-hosting/architecture/` },
  { name: "TypeScript", icon: typescript, href: `${docs}/reference/sdk-options/` },
  { name: "React", icon: react, href: `${docs}/sdk/browser/` },
  { name: "ClickHouse", icon: clickhouse, href: `${docs}/self-hosting/clickhouse/` },
  { name: "PostgreSQL", icon: postgres, href: `${docs}/self-hosting/postgres/` },
  { name: "Kafka", icon: kafka, href: `${docs}/self-hosting/kafka/` },
];
---

<ul class="lp-tech-dock" aria-label={zh ? "技术栈" : "Technology stack"}>
  {
    items.map(({ name, icon, href }, index) => (
      <li style={`--lp-order:${index}`}>
        <a href={href} class="lp-tech-link" aria-label={name}>
          <Fragment set:html={icon} />
          <span class="lp-tech-label" aria-hidden="true">
            {name}
          </span>
        </a>
      </li>
    ))
  }
</ul>
