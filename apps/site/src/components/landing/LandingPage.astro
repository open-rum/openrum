---
import {
  ArrowRight,
  Check,
  Database,
  Github,
  PlayCircle,
  Server,
  ShieldCheck,
  TriangleAlert,
} from "lucide-astro";
import StrokeText from "./StrokeText.jsx";
import BrandMark from "../BrandMark.astro";
import TechStack from "./TechStack.astro";
import Reliability from "./Reliability.astro";
import FeatureBento from "./FeatureBento.astro";
import Dashboards from "./Dashboards.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import "../../styles/landing.css";
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const repository = import.meta.env.PUBLIC_REPOSITORY_URL || "https://github.com/openrum/openrum";
const docs = zh ? "/zh/docs" : "/docs";
const copy = zh
  ? {
      sloganLead: "了解你的用户",
      sloganAccent: "快速修复问题",
      description: "追踪应用错误、分析用户行为、监控应用性能，数据完全掌握在自己手里。",
      quick: "立即开始",
      exampleTag: "示例",
      appRange: "最近 7 天",
      topPagesTitle: "热门页面",
      topPagesRows: [
        ["/product", "32.4%"],
        ["/checkout", "18.7%"],
        ["/dashboard", "12.3%"],
        ["/profile", "8.9%"],
        ["/", "6.1%"],
      ],
      errorTitle: "快速定位并修复问题",
      errorLead:
        "获取完整的错误上下文，包括堆栈信息、面包屑、用户信息和更多内容，减少调试时间，提升稳定性。",
      errorCalloutLead: "从错误到修复",
      errorCallout: "只需几分钟，而不是几小时。",
      errorStatus: "Open",
      errorType: "TypeError",
      errorMessage: "Cannot read properties of undefined (reading 'map')",
      errorTabs: ["详情", "追踪信息", "标签", "用户", "设备", "原始数据"],
      errorMeta: [
        ["事件 ID", "7f3a2e6c-8b4d-4a4f-9e2c-1d65e8a77f2b"],
        ["发生时间", "2025-08-03 14:32:18（2 小时前）"],
        ["URL", "https://app.example.com/product"],
        ["用户", "user_123456"],
        ["浏览器", "Chrome 126.0.0.0"],
        ["设备", "Mac OS 14.5 - MacBook Pro"],
      ],
      stackLabel: "堆栈信息",
      analyticsEyebrow: "行为分析",
      analyticsTitle: "了解用户在做什么",
      analyticsLead:
        "PV/UV、会话、来源和自定义事件与错误落在同一份数据里，所以「这个错误值不值得今天修」是能回答的。",
      analyticsQuote: "错误告诉你哪里坏了，行为分析告诉你它为什么重要。",
      analyticsLink: "查看行为分析能力",
      analyticsStats: [
        ["页面浏览", "128.4K"],
        ["独立用户", "32.8K"],
        ["会话", "46.2K"],
        ["跳出率", "38%"],
      ],
      proofEyebrow: "自部署",
      proofTitle: "你的数据，你的服务器",
      proofLead: "部署在你自己的基础设施上，监控数据从头到尾不经过第三方。",
      proof: [
        ["可选对象存储", "没有 Bucket 时核心监控仍可运行；Source Map 可接 OSS 或 S3-compatible。"],
        ["数据生命周期", "原始与聚合数据按项目策略物理过期，历史清理可预览、审计和限速。"],
        ["透明证据", "公开 Demo seed、压测方法与失败结果，不把本地演练包装成生产容量声明。"],
      ],
      deployList: ["Docker Compose", "Kubernetes", "无厂商锁定", "数据完全自持"],
      terminalTitle: "本地启动一套完整实例",
      terminalComment: "# 拉起全部服务",
      terminalNote: "容器就绪后访问 http://127.0.0.1:4173 完成初始化，无需注册任何账号。",
    }
  : {
      sloganLead: "Understand your users",
      sloganAccent: "Fix issues faster",
      description:
        "Track errors, analyze user behavior, and monitor application performance — all on your own infrastructure.",
      quick: "Get started",
      exampleTag: "Example",
      appRange: "Last 7 days",
      topPagesTitle: "Top Pages",
      topPagesRows: [
        ["/product", "32.4%"],
        ["/checkout", "18.7%"],
        ["/dashboard", "12.3%"],
        ["/profile", "8.9%"],
        ["/", "6.1%"],
      ],
      errorTitle: "Find and fix issues, faster",
      errorLead:
        "Get full error context with stack traces, breadcrumbs, user information and more. Reduce debugging time and improve stability.",
      errorCalloutLead: "From error to fix",
      errorCallout: "in minutes, not hours.",
      errorStatus: "Open",
      errorType: "TypeError",
      errorMessage: "Cannot read properties of undefined (reading 'map')",
      errorTabs: ["Details", "Breadcrumbs", "Tags", "User", "Device", "Raw"],
      errorMeta: [
        ["Event ID", "7f3a2e6c-8b4d-4a4f-9e2c-1d65e8a77f2b"],
        ["Occurred", "2025-08-03 14:32:18 (2 hours ago)"],
        ["URL", "https://app.example.com/product"],
        ["User", "user_123456"],
        ["Browser", "Chrome 126.0.0.0"],
        ["Device", "Mac OS 14.5 - MacBook Pro"],
      ],
      stackLabel: "Stack Trace",
      analyticsEyebrow: "Behavior analytics",
      analyticsTitle: "Understand what your users do",
      analyticsLead:
        "Page views, sessions, acquisition and Custom Events sit in the same dataset as your errors, so “is this error worth fixing today” is a question you can answer.",
      analyticsQuote: "Errors tell you what broke. Analytics tells you why it matters.",
      analyticsLink: "See behavior analytics",
      analyticsStats: [
        ["Page views", "128.4K"],
        ["Unique users", "32.8K"],
        ["Sessions", "46.2K"],
        ["Bounce rate", "38%"],
      ],
      proofEyebrow: "Self-hosted",
      proofTitle: "Your data. Your server.",
      proofLead:
        "Deploy on your own infrastructure. Monitoring data never passes through anyone else.",
      proof: [
        [
          "Optional object storage",
          "Core monitoring runs without a Bucket; Source Maps can use OSS or an S3-compatible provider.",
        ],
        [
          "Data lifecycle",
          "Raw and aggregate data expire by Project policy; historical cleanup is previewed, audited and rate-limited.",
        ],
        [
          "Transparent evidence",
          "Demo seeds, benchmark methods and failed overload results are public—not promoted as production capacity.",
        ],
      ],
      deployList: ["Docker Compose", "Kubernetes", "No vendor lock-in", "Full data ownership"],
      terminalTitle: "Bring up a full instance locally",
      terminalComment: "# start every service",
      terminalNote:
        "Once the containers report ready, open http://127.0.0.1:4173 to finish setup. No account signup required.",
    };
const proofIcons = [Server, Database, ShieldCheck];
const trendAxis = ["Jul 26", "Jul 27", "Jul 28", "Jul 29", "Jul 30", "Jul 31", "Aug 1"];
const stackFrames = [
  ["TypeError: Cannot read properties of undefined (reading 'map')", ""],
  ["  at ProductList", "(.../src/pages/product/index.tsx:45:22)"],
  ["  at renderWithHooks", "(react-dom.development.js:16067:18)"],
  ["  at mountIndeterminateComponent", "(react-dom.development.js:20074:17)"],
];
const pageTitle = zh
  ? "OpenRUM — 了解你的用户，快速修复问题"
  : "OpenRUM — Understand your users. Fix issues faster.";
---

<PublicLayout title={pageTitle} description={copy.description} lang={lang}>
  <div class="lp-page">
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <div class="site-container lp-hero-content">
        <p class="lp-hero-badge">
          <span class="lp-hero-badge-dot" aria-hidden="true"></span>
          Open Source <span aria-hidden="true">·</span> Alpha
        </p>
        <h1 id="lp-hero-title">
          <span class="lp-title-line">
            <StrokeText client:load text={copy.sloganLead} fillColor="var(--ds-action-contrast)" />
          </span>
          <span class="lp-title-line lp-accent">
            <StrokeText
              client:load
              text={copy.sloganAccent}
              strokeColor="var(--ds-primary)"
              fillColor="var(--ds-action-contrast)"
            />
          </span>
        </h1>
        <p class="lp-hero-copy">{copy.description}</p>
        <div class="lp-cta">
          <a
            class="ui-button ui-button-contrast lp-cta-button"
            href={`${docs}/getting-started/quickstart/`}
          >
            {copy.quick}<ArrowRight data-icon="inline-end" size={17} />
          </a>
          <a class="ui-button ui-button-neutral lp-cta-button" href={repository}>
            <Github data-icon="inline-start" size={17} />GitHub
          </a>
        </div>
        <TechStack lang={lang} />
      </div>
    </section>

    <FeatureBento lang={lang} />

    <Reliability lang={lang} />

    <section class="lp-section lp-rule">
      <div class="site-container lp-split lp-reveal">
        <div class="lp-app">
          <div class="lp-app-bar lp-app-bar-issue">
            <span class="lp-issue-mark"><TriangleAlert size={13} /></span>
            <strong class="lp-issue-title"
              ><span class="lp-issue-type">{copy.errorType}:</span>
              {copy.errorMessage}</strong
            >
            <span class="lp-issue-status">{copy.errorStatus}</span>
          </div>
          <div class="lp-app-body">
            <ul class="lp-tabs">
              {
                copy.errorTabs.map((tab, index) => (
                  <li class={index === 0 ? "is-active" : ""}>{tab}</li>
                ))
              }
            </ul>
            <dl class="lp-meta">
              {
                copy.errorMeta.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="lp-app-label" id="lp-stack-label">{copy.stackLabel}</p>
            <pre
              class="lp-stack"
              tabindex="0"
              role="group"
              aria-labelledby="lp-stack-label"><code>{stackFrames.map(([symbol, location]) => (
              <span class="lp-stack-frame"><span class="lp-stack-symbol">{symbol}</span>{location ? " " : ""}<span class="lp-stack-location">{location}</span></span>
            ))}</code></pre>
          </div>
        </div>
        <div class="lp-split-copy">
          <h2 class="lp-split-title">{copy.errorTitle}</h2>
          <p>{copy.errorLead}</p>
          <div class="lp-callout">
            <span class="lp-callout-icon"><PlayCircle size={19} /></span>
            <p>
              <strong>{copy.errorCalloutLead}</strong>
              <span>{copy.errorCallout}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-section lp-rule">
      <div class="site-container lp-split lp-split-reverse lp-reveal">
        <div class="lp-split-copy">
          <p class="lp-eyebrow">{copy.analyticsEyebrow}</p>
          <h2>{copy.analyticsTitle}</h2>
          <p>{copy.analyticsLead}</p>
          <blockquote class="lp-quote">{copy.analyticsQuote}</blockquote>
          <a class="lp-tile-link" href={`${docs}/product/analytics/`}>{copy.analyticsLink} →</a>
        </div>
        <div class="lp-app">
          <div class="lp-app-bar">
            <span class="lp-app-brand"
              ><span class="lp-app-mark"><BrandMark size={16} /></span><span class="lp-app-word"
                >Analytics</span
              ></span
            >
            <span class="lp-app-tag">{copy.exampleTag}</span>
            <span class="lp-app-chip">{copy.appRange}</span>
          </div>
          <div class="lp-app-body">
            <dl class="lp-stats">
              {
                copy.analyticsStats.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>
            <figure class="lp-chart">
              <figcaption>{copy.analyticsStats[0][0]}</figcaption>
              <div class="lp-bars">
                {[46, 62, 51, 78, 66, 91, 84].map((height) => <span style={`height:${height}%`} />)}
              </div>
              <ol class="lp-chart-axis" aria-hidden="true">
                {trendAxis.map((tick) => <li>{tick}</li>)}
              </ol>
            </figure>
            <p class="lp-app-label">{copy.topPagesTitle}</p>
            <ul class="lp-top-pages">
              {
                copy.topPagesRows.map(([path, share]) => (
                  <li>
                    <span class="lp-top-path">{path}</span>
                    <span class="lp-top-bar" style={`--lp-share:${share}`} />
                    <span class="lp-top-share">{share}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <Dashboards lang={lang} />

    <section class="lp-section lp-rule">
      <div class="site-container">
        <div class="lp-head lp-reveal">
          <p class="lp-eyebrow">{copy.proofEyebrow}</p>
          <h2>{copy.proofTitle}</h2>
          <p>{copy.proofLead}</p>
        </div>
        <div class="lp-proof-grid">
          <div class="lp-reveal">
            <ul class="lp-proof-list">
              {
                copy.proof.map(([title, body], index) => {
                  const Icon = proofIcons[index];
                  return (
                    <li class="lp-proof-item">
                      <span class="lp-tile-icon" style="margin-bottom:0">
                        <Icon size={19} />
                      </span>
                      <div>
                        <strong>{title}</strong>
                        <p>{body}</p>
                      </div>
                    </li>
                  );
                })
              }
            </ul>
            <ul class="lp-deploy-list">
              {
                copy.deployList.map((item) => (
                  <li>
                    <Check size={14} />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="lp-reveal">
            <div class="lp-terminal">
              <div class="lp-terminal-bar">
                <span></span><span></span><span></span><strong>{copy.terminalTitle}</strong>
              </div>
              <pre><code><span class="lp-terminal-comment">{copy.terminalComment}</span>
docker compose <span class="lp-terminal-flag">--env-file</span> deploy/compose/.env.example \
  <span class="lp-terminal-flag">-f</span> deploy/compose/docker-compose.yml up <span class="lp-terminal-flag">-d --build</span>

curl --fail http://127.0.0.1:4173/health/ready</code></pre>
            </div>
            <p class="lp-terminal-note">{copy.terminalNote}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</PublicLayout>
