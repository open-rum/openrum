---
import { ChartLine, LayoutDashboard, ListChecks, Scale, Workflow } from "lucide-astro";
import BrandMark from "../BrandMark.astro";

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const docs = zh ? "/zh/docs" : "/docs";
// Copy describes the Alpha dashboards as implemented: personal copies of a built-in
// default, a code-defined metric catalog and the chart rules in the dashboards guide.
const copy = zh
  ? {
      eyebrow: "仪表盘",
      title: "每位成员，都有自己的仪表盘。",
      lead: "内置默认仪表盘开箱即用。编辑后保存的是你自己的副本，默认仪表盘对任何人都不会改变。",
      points: [
        {
          icon: LayoutDashboard,
          title: "多张命名仪表盘，现成模板",
          body: "每个项目最多保存 20 张仪表盘，每张最多 24 个模块。可以从默认布局或模板开始：流量与会话、性能、API 健康、错误分析、业务指标。",
        },
        {
          icon: ListChecks,
          title: "精选指标目录，无需编写查询",
          body: "流量与会话、Web Vitals（P75）、API 请求结果与延迟分位、错误事件数、受影响用户与新增 Issue、自定义事件数值（总和、平均值、P50/P90），以及用户行为事件的次数、用户数和会话数。",
        },
        {
          icon: ChartLine,
          title: "为问题选对图表",
          body: "指标卡显示相比上一周期的变化；趋势图可叠加上一周期虚线；堆叠图展示构成；维度分布可选排行条、表格或圆环；排行表每行带迷你趋势；指标表并排比较多个指标。",
        },
        {
          icon: Workflow,
          title: "把支付流程放进一张图",
          body: "将多个自定义事件画成各自的折线，例如「发起支付」「支付成功」「支付失败」，一眼看出支付在哪里流失。",
        },
      ],
      honestTitle: "数字可信",
      honest: [
        "一张图一个单位",
        "只有整体的组成部分才能堆叠",
        "没有数据的时间桶留空，不画成 0",
        "每张图约 30 个点",
      ],
      link: "了解仪表盘",
      mockName: "支付观察",
      mockTag: "示例",
      mockRange: "最近 7 天",
      mockDelta: "较上期",
      stats: [
        ["支付成功", "12,480", "+8.2%"],
        ["订单金额 · 总和", "184.2K", "+5.1%"],
        ["支付失败", "312", "−12.4%"],
      ],
      chartTitle: "支付事件",
      series: ["发起支付", "支付成功", "支付失败"],
      axis: ["周一", "周三", "周五", "周日"],
      tableTitle: "订单金额 · 按国家/地区",
      rows: [
        ["美国", "62.4K", "+6%"],
        ["德国", "28.1K", "+3%"],
        ["日本", "21.7K", "−2%"],
        ["巴西", "12.9K", "+11%"],
      ],
    }
  : {
      eyebrow: "Dashboards",
      title: "Every member gets their own dashboards.",
      lead: "A built-in default dashboard works out of the box. Edit it and you save your own copy — the default never changes for anyone.",
      points: [
        {
          icon: LayoutDashboard,
          title: "Named dashboards, ready-made templates",
          body: "Keep up to 20 dashboards per Project, each with up to 24 modules. Start from the default or a template: traffic & Sessions, performance, API health, error analysis or business metrics.",
        },
        {
          icon: ListChecks,
          title: "A curated metric catalog, not a query editor",
          body: "Traffic and Sessions, Web Vitals at P75, API outcomes and latency percentiles, Issue events, affected users and new Issues, Custom Event measurements (sum, average, P50/P90) and user behavior events by count, users and Sessions.",
        },
        {
          icon: ChartLine,
          title: "Charts that fit the question",
          body: "Stats with the change against the previous period, trends with the previous period as a dashed overlay, stacked composition, breakdowns as bars, a table or a donut, ranked tables with a sparkline per row, and multi-metric tables.",
        },
        {
          icon: Workflow,
          title: "Put checkout on one chart",
          body: "Plot several Custom Events as separate lines — Checkout started, Payment succeeded and Payment failed — and see where payments drop off.",
        },
      ],
      honestTitle: "Honest numbers",
      honest: [
        "One unit per chart",
        "Only parts of a whole stack",
        "Empty buckets stay empty, never drawn as zero",
        "About 30 points per chart",
      ],
      link: "Read the dashboards guide",
      mockName: "Checkout",
      mockTag: "Example",
      mockRange: "Last 7 days",
      mockDelta: "vs previous",
      stats: [
        ["Payment succeeded", "12,480", "+8.2%"],
        ["Order amount · sum", "184.2K", "+5.1%"],
        ["Payment failed", "312", "−12.4%"],
      ],
      chartTitle: "Checkout events",
      series: ["Checkout started", "Payment succeeded", "Payment failed"],
      axis: ["Mon", "Wed", "Fri", "Sun"],
      tableTitle: "Order amount · by country",
      rows: [
        ["United States", "62.4K", "+6%"],
        ["Germany", "28.1K", "+3%"],
        ["Japan", "21.7K", "−2%"],
        ["Brazil", "12.9K", "+11%"],
      ],
    };

// Illustrative series with the same ~30-point budget the product uses. Two buckets of
// the failure line are missing to show that an empty bucket is a gap, not a zero.
const points = 30;
const started = Array.from(
  { length: points },
  (_, i) => 64 + 13 * Math.sin(i / 4.2) + 5 * Math.sin(i * 1.3),
);
const succeeded = started.map((value, i) => value * 0.82 - 2.5 * Math.sin(i * 0.9));
const failed = Array.from(
  { length: points },
  (_, i) => 9 + 3 * Math.sin(i / 3 + 1) + 1.5 * Math.sin(i * 1.7),
);
const x = (i: number) => ((i / (points - 1)) * 300).toFixed(1);
const y = (value: number) => (100 - value).toFixed(1);
const path = (values: number[], gaps: number[] = []) =>
  values
    .map((value, i) => {
      if (gaps.includes(i)) return "";
      const move = i === 0 || gaps.includes(i - 1) ? "M" : "L";
      return `${move}${x(i)} ${y(value)}`;
    })
    .join(" ")
    .trim();
const lines = [path(started), path(succeeded), path(failed, [17, 18])];
const sparkline = (seed: number, rising: boolean) =>
  Array.from({ length: 12 }, (_, i) => {
    const trend = rising ? i * 1.3 : -i * 0.6;
    const value = 12 + trend + 3 * Math.sin(i * 1.1 + seed);
    return `${i === 0 ? "M" : "L"}${((i / 11) * 60).toFixed(1)} ${(28 - value).toFixed(1)}`;
  }).join(" ");
---

<section class="lp-section lp-rule dash-section" id="dashboards" aria-labelledby="dash-title">
  <div class="site-container">
    <header class="lp-head lp-reveal">
      <p class="lp-eyebrow">{copy.eyebrow}</p>
      <h2 id="dash-title">{copy.title}</h2>
      <p>{copy.lead}</p>
    </header>

    <div class="dash-layout">
      <div class="lp-app dash-mock lp-reveal" aria-hidden="true">
        <div class="lp-app-bar">
          <span class="lp-app-brand"
            ><span class="lp-app-mark"><BrandMark size={16} /></span><span class="lp-app-word"
              >{copy.mockName}</span
            ></span
          >
          <span class="lp-app-tag">{copy.mockTag}</span>
          <span class="lp-app-chip">{copy.mockRange}</span>
        </div>
        <div class="lp-app-body">
          <div class="dash-stats">
            {
              copy.stats.map(([label, value, delta]) => (
                <div class="dash-tile">
                  <span class="dash-tile-label">{label}</span>
                  <strong>{value}</strong>
                  <span class="dash-tile-delta">
                    {delta} <span>{copy.mockDelta}</span>
                  </span>
                </div>
              ))
            }
          </div>

          <div class="dash-card">
            <p class="dash-card-title">{copy.chartTitle}</p>
            <svg class="dash-lines" viewBox="0 0 300 100" preserveAspectRatio="none">
              {[25, 50, 75].map((line) => <path class="dash-grid" d={`M0 ${line}H300`} />)}
              {lines.map((d, index) => <path class={`dash-line dash-series-${index + 1}`} d={d} />)}
            </svg>
            <div class="dash-axis">{copy.axis.map((tick) => <span>{tick}</span>)}</div>
            <ul class="dash-legend">
              {
                copy.series.map((name, index) => (
                  <li>
                    <i class={`dash-series-${index + 1}`} />
                    {name}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="dash-card">
            <p class="dash-card-title">{copy.tableTitle}</p>
            <ol class="dash-rank">
              {
                copy.rows.map(([name, value, change], index) => (
                  <li>
                    <span class="dash-rank-name">{name}</span>
                    <svg class="dash-spark" viewBox="0 0 60 28" preserveAspectRatio="none">
                      <path d={sparkline(index * 1.7, !change.startsWith("−"))} />
                    </svg>
                    <span class="dash-rank-value">{value}</span>
                    <span class="dash-rank-change">{change}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <div class="dash-copy">
        <ul class="dash-points">
          {
            copy.points.map(({ icon: Icon, title, body }) => (
              <li class="lp-reveal">
                <span class="dash-point-icon">
                  <Icon size={19} aria-hidden="true" />
                </span>
                <div>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="dash-honest lp-reveal">
      <h3><Scale size={17} aria-hidden="true" />{copy.honestTitle}</h3>
      <ul>
        {copy.honest.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <a class="lp-tile-link" href={`${docs}/product/dashboards/`}>{copy.link} →</a>
  </div>
</section>

<style>
  .dash-section {
    scroll-margin-top: var(--site-nav-height);
  }
  .dash-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: start;
    gap: 48px;
  }

  /* ---------- Mock dashboard ---------- */

  .dash-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
  }
  .dash-tile,
  .dash-card {
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid var(--lp-hairline);
    border-radius: 11px;
    background: color-mix(in oklch, var(--ds-surface), transparent 34%);
  }
  .dash-tile {
    display: grid;
    gap: 7px;
  }
  .dash-tile-label {
    overflow: hidden;
    color: var(--ds-text-muted);
    font-size: 0.66rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dash-tile strong {
    font: 700 1.2rem/1 var(--font-product-sans);
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .dash-tile-delta {
    overflow: hidden;
    color: var(--ds-text-secondary);
    font: 650 0.64rem/1.2 var(--font-product-sans);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dash-tile-delta span {
    color: var(--ds-text-muted);
    font-weight: 400;
  }
  .dash-card {
    margin-top: 10px;
  }
  .dash-card-title {
    margin: 0 0 9px;
    color: var(--ds-text-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dash-lines {
    display: block;
    width: 100%;
    height: 96px;
    overflow: visible;
  }
  .dash-grid {
    stroke: var(--lp-hairline);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .dash-line {
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .dash-line.dash-series-1 {
    stroke: var(--ds-chart-2);
  }
  .dash-line.dash-series-2 {
    stroke: var(--ds-chart-5);
  }
  .dash-line.dash-series-3 {
    stroke: var(--ds-chart-6);
  }
  .dash-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 7px;
    color: var(--ds-text-muted);
    font: 0.6rem/1 var(--font-mono);
  }
  .dash-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ds-text-secondary);
    font-size: 0.68rem;
  }
  .dash-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dash-legend i {
    width: 12px;
    height: 3px;
    border-radius: 2px;
  }
  .dash-legend .dash-series-1 {
    background: var(--ds-chart-2);
  }
  .dash-legend .dash-series-2 {
    background: var(--ds-chart-5);
  }
  .dash-legend .dash-series-3 {
    background: var(--ds-chart-6);
  }
  .dash-rank {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dash-rank li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 60px 3.2rem 2.6rem;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    font-size: 0.72rem;
  }
  .dash-rank li + li {
    border-top: 1px solid var(--lp-hairline);
  }
  .dash-rank-name {
    overflow: hidden;
    color: var(--ds-text-secondary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dash-spark {
    width: 60px;
    height: 20px;
  }
  .dash-spark path {
    fill: none;
    stroke: var(--ds-chart-2);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .dash-rank-value,
  .dash-rank-change {
    font: 0.72rem/1.4 var(--font-mono);
    text-align: right;
  }
  .dash-rank-change {
    color: var(--ds-text-muted);
  }

  /* ---------- Copy ---------- */

  .dash-points {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dash-points li {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 16px;
  }
  .dash-point-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--ds-selection);
    color: var(--ds-selection-foreground);
  }
  .dash-points h3 {
    margin: 0 0 6px;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }
  .dash-points p {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: 0.9rem;
    line-height: 1.66;
  }
  .dash-honest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 44px;
    padding: 18px 22px;
    border: 1px dashed color-mix(in oklch, var(--ds-primary), transparent 62%);
    border-radius: 14px;
  }
  .dash-honest h3 {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.94rem;
    font-weight: 650;
  }
  .dash-honest ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ds-text-secondary);
    font-size: 0.86rem;
  }
  .dash-honest li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dash-honest li::before {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    content: "";
    background: var(--ds-primary);
  }

  @media (max-width: 1000px) {
    .dash-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .dash-layout {
      gap: 36px;
    }
    .dash-honest {
      display: block;
      padding: 16px;
    }
    .dash-honest ul {
      display: grid;
      margin-top: 12px;
    }
    .dash-honest li {
      align-items: baseline;
    }
  }
  @media (max-width: 420px) {
    .dash-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dash-tile:last-child {
      grid-column: 1 / -1;
    }
    .dash-rank li {
      grid-template-columns: minmax(0, 1fr) 44px 3.2rem 2.4rem;
      gap: 8px;
    }
    .dash-spark {
      width: 44px;
    }
  }
</style>
