---
// cspell:ignore nums
import {
  ArrowRight,
  Braces,
  Monitor,
  Server,
  Database,
  Layers,
  Cpu,
  Network,
  Gauge,
} from "lucide-astro";
import evidence from "../../content/evidence/local-capacity-2026-09-18.json";

const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const docs = zh ? "/zh/docs" : "/docs";
// Both public surfaces share measured evidence. Local, short-run results are
// not production capacity; keep hardware, workload and gate status visible.
const layers = [
  {
    name: zh ? "采集与交互" : "Capture & explore",
    icon: Monitor,
    nodes: [
      ["Browser SDK", zh ? "行为 · 错误 · 性能" : "Behavior · errors · vitals"],
      ["Console", zh ? "分析 · 调查 · 配置" : "Analyze · investigate · configure"],
    ],
  },
  {
    name: zh ? "服务接入" : "Service layer",
    icon: Server,
    nodes: [
      ["Ingest", zh ? "鉴权与校验 · 接收上报" : "Authenticate · validate · receive"],
      ["API", zh ? "查询接口 · 项目管理" : "Query API · project management"],
    ],
  },
  {
    name: zh ? "消息缓冲" : "Message buffer",
    icon: Layers,
    nodes: [
      ["Kafka", zh ? "分区队列 · 解耦接收与消费" : "Partitioned queue · decoupled ingestion"],
    ],
  },
  {
    name: zh ? "异步处理" : "Async processing",
    icon: Cpu,
    nodes: [
      ["Consumer", zh ? "消费事件 · 写入分析存储" : "Consume events · write analytics"],
      ["Worker", zh ? "后台任务 · 告警与堆栈处理" : "Background jobs · alerts · stack processing"],
    ],
  },
  {
    name: zh ? "数据存储" : "Data stores",
    icon: Database,
    nodes: [
      ["ClickHouse", zh ? "事件与聚合分析" : "Events & analytics"],
      ["PostgreSQL", zh ? "项目与配置" : "Projects & configuration"],
      ["Redis", zh ? "限流与缓存" : "Limits & cache"],
      [zh ? "对象存储（可选）" : "Object storage (optional)", "Source Maps"],
    ],
  },
];
const benefits = [
  {
    icon: Braces,
    title: zh ? "Go 服务，独立扩容" : "Go services. Independent scaling.",
    body: zh
      ? "接收、消费、查询各司其职，按实际负载调整服务副本。"
      : "Scale ingestion, consumption and queries independently to match your workload.",
  },
  {
    icon: Network,
    title: zh ? "异步管道，缓冲峰值" : "An async pipeline for traffic spikes.",
    body: zh
      ? "Kafka 缓冲已接收的事件，让写入与分析查询解耦。"
      : "Kafka buffers accepted events, decoupling ingestion from analytics queries.",
  },
  {
    icon: Gauge,
    title: zh ? "列式存储，面向分析" : "Columnar storage for analytics.",
    body: zh
      ? "ClickHouse 承载事件与聚合查询，PostgreSQL 管理项目和配置。"
      : "ClickHouse serves event analytics while PostgreSQL manages projects and configuration.",
  },
];
const metrics = [
  {
    value: "≈ " + evidence.acknowledgedEventsPerSecond.toLocaleString(zh ? "zh-CN" : "en-US"),
    unit: "events/s",
    title: zh ? "实测确认接收吞吐" : "Measured acknowledged throughput",
    detail: zh
      ? `${evidence.durationSeconds / 60} 分钟混合事件持续测试`
      : `${evidence.durationSeconds / 60}-minute mixed-event run`,
  },
  {
    value: String(evidence.ingestP95Milliseconds),
    unit: "ms",
    title: zh ? "接收延迟 P95" : "Ingest latency P95",
    detail: zh ? "等待 Kafka 确认后响应" : "Response after Kafka acknowledgment",
  },
  {
    value: String(evidence.queryP95Milliseconds),
    unit: "ms",
    title: zh ? "查询延迟 P95" : "Query latency P95",
    detail: zh
      ? `同时施加 ${evidence.targetQueriesPerSecond} 次/秒查询`
      : `${evidence.targetQueriesPerSecond} query req/s alongside ingest`,
  },
  {
    value: String(evidence.ingestFailurePercent),
    unit: "%",
    title: zh ? "上报失败 / 超时比例" : "Ingest failure / timeout rate",
    detail: zh
      ? `查询失败率 ${evidence.queryFailurePercent}% · 已核对入库`
      : `Query failures: ${evidence.queryFailurePercent}% · storage reconciled`,
  },
];
---

<section
  class="architecture-section lp-rule"
  id="architecture"
  aria-labelledby="architecture-title"
>
  <div class="site-container">
    <header class="architecture-heading">
      <div>
        <p class="lp-eyebrow">{zh ? "高性能架构" : "Architecture for scale"}</p>
        <h2 id="architecture-title">
          {zh ? "分层解耦，" : "Decoupled by design."}<br />{
            zh ? "为高吞吐而构建。" : "Built for growing workloads."
          }
        </h2>
      </div>
      <div class="architecture-intro">
        <p>
          {
            zh
              ? "从浏览器采集，到异步处理与分析查询。让每一层专注自己的工作，随业务规模独立扩展。"
              : "From browser capture to asynchronous processing and analytics. Each layer has a clear role and room to scale."
          }
        </p>
        <a href={`${docs}/self-hosting/architecture/`}
          >{zh ? "了解完整架构" : "Explore the architecture"}<ArrowRight size={16} /></a
        >
      </div>
    </header>

    <div class="architecture-layout">
      <figure class="architecture-diagram">
        <figcaption>
          <span><Layers size={17} />{zh ? "分层服务架构" : "Layered service architecture"}</span
          ><span class="architecture-diagram-tag">OpenRUM</span>
        </figcaption>
        <ol class="architecture-layers">
          {
            layers.map(({ name, icon: Icon, nodes }, index) => (
              <li class={`architecture-layer ${index === 2 ? "architecture-layer-buffer" : ""}`}>
                <div class="architecture-layer-label">
                  <>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <Icon size={16} />
                    <strong>{name}</strong>
                  </>
                </div>
                <div class="architecture-nodes">
                  {nodes.map(([title, detail]) => (
                    <div class="architecture-node">
                      <strong>{title}</strong>
                      <span>{detail}</span>
                    </div>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
        <div class="architecture-flows">
          <p>
            <span>{zh ? "写入路径" : "Write path"}</span>SDK → Ingest → Kafka → Consumer →
            ClickHouse
          </p>
          <p><span>{zh ? "查询路径" : "Read path"}</span>Console → API → ClickHouse / PostgreSQL</p>
        </div>
      </figure>
      <aside
        class="architecture-benefits"
        aria-label={zh ? "架构设计要点" : "Architecture highlights"}
      >
        {
          benefits.map(({ icon: Icon, title, body }) => (
            <article>
              <>
                <span class="architecture-benefit-icon">
                  <Icon size={21} />
                </span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))
        }
        <a class="architecture-deploy-link" href={`${docs}/self-hosting/kubernetes/`}
          >Kubernetes / Helm<ArrowRight size={16} /></a
        >
      </aside>
    </div>

    <div class="architecture-benchmark">
      <header class="architecture-benchmark-header">
        <div>
          <p class="lp-eyebrow">{zh ? "性能验证" : "Performance evidence"}</p><h3>
            {zh ? "公开实测，清楚标注边界。" : "Measured results. Clear boundaries."}
          </h3>
        </div>
        <span class="architecture-status" data-passed={String(evidence.passed)}
          >{
            evidence.passed
              ? zh
                ? "本地单机 · 短时测试通过"
                : "Local single machine · short run passed"
              : zh
                ? "本地单机 · 部分门槛未通过"
                : "Local single machine · some gates failed"
          }</span
        >
      </header>
      <p class="architecture-benchmark-context">
        {
          zh
            ? "单机 Docker Compose · 服务单副本 · 1 个 Kafka Broker · 1 个 ClickHouse 节点"
            : "Single-machine Docker Compose · single-replica services · 1 Kafka broker · 1 ClickHouse node"
        }
      </p>
      <p class="architecture-hardware">
        <Cpu size={17} /><strong
          >{evidence.hardware.cpu} · {evidence.hardware.cpuCores}
          {zh ? "核" : "cores"} · {evidence.hardware.memoryGiB} GiB RAM</strong
        >
        <span
          >Docker VM · {evidence.hardware.dockerCPUs} vCPU / {evidence.hardware.dockerMemoryGiB} GiB</span
        >
      </p>
      <dl class="architecture-metrics">
        {
          metrics.map(({ value, unit, title, detail }) => (
            <div>
              <>
                <dt>{title}</dt>
                <dd>
                  {value}
                  <small>{unit}</small>
                  <p>{detail}</p>
                </dd>
              </>
            </div>
          ))
        }
      </dl>
      <div class="architecture-benchmark-footer">
        <p>
          <strong
            >{zh ? "生产并发能力：待验证。" : "Production concurrency: not yet validated."}</strong
          >{" "}{
            zh
              ? `本轮持续 ${evidence.durationSeconds / 60} 分钟，目标 ${evidence.targetEventsPerSecond.toLocaleString()} events/s + ${evidence.targetQueriesPerSecond} 次/秒查询。已核对 ${evidence.acceptedEvents.toLocaleString()} 条事件全部入库且无重复。本轮及保守档位仍有查询失败，完整记录已保留。吞吐量不等于并发用户数。`
              : `This ${evidence.durationSeconds / 60}-minute run targeted ${evidence.targetEventsPerSecond.toLocaleString()} events/s + ${evidence.targetQueriesPerSecond} query req/s. All ${evidence.acceptedEvents.toLocaleString()} acknowledged events were stored without duplicates. Queries still failed at this and a lower load; the full record is retained. Throughput is not concurrent users.`
          }
        </p>
      </div>
      <p class="architecture-benchmark-note">
        {evidence.date} · {evidence.id} · {
          zh
            ? "生产环境容量需在目标部署规格下完成压测后发布。"
            : "Production capacity requires a passing benchmark on the intended deployment topology."
        }
      </p>
    </div>
  </div>
</section>

<style>
  .architecture-section {
    padding-block: 88px;
    scroll-margin-top: var(--site-nav-height);
  }
  .architecture-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 48px;
    margin-bottom: 36px;
  }
  .architecture-heading h2 {
    margin: 16px 0 0;
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .architecture-intro {
    max-width: 430px;
  }
  .architecture-intro p {
    margin: 0 0 18px;
    color: var(--ds-text-muted);
    font-size: 16px;
    line-height: 1.75;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ds-text);
    font-size: 14px;
    text-decoration: none;
    min-height: 44px;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  a:focus-visible {
    outline: 2px solid var(--ds-ring);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .architecture-layout {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr);
    gap: 28px;
  }
  .architecture-diagram {
    min-width: 0;
    margin: 0;
    padding: 24px;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-lg);
    background: var(--ds-surface);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 550;
  }
  figcaption > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .architecture-diagram-tag {
    font-size: 12px;
    color: var(--ds-text-muted);
    font-weight: 400;
  }
  .architecture-layers {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .architecture-layer {
    display: grid;
    grid-template-columns: 142px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-md);
    background: var(--ds-canvas);
  }
  .architecture-layer-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
  }
  .architecture-layer-label > span {
    font: 10px var(--font-mono);
    color: var(--ds-text-muted);
    margin-right: 3px;
  }
  .architecture-layer-label strong {
    font-weight: 500;
  }
  .architecture-layer-label :global(svg) {
    flex-shrink: 0;
  }
  .architecture-nodes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .architecture-node {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 10px 12px;
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-sm);
  }
  .architecture-node strong {
    font-size: 13px;
    font-weight: 550;
  }
  .architecture-node span {
    font-size: 11px;
    color: var(--ds-text-muted);
    line-height: 1.5;
  }
  .architecture-layer-buffer {
    border-color: color-mix(in oklch, var(--ds-primary) 60%, var(--ds-border));
  }
  .architecture-layer-buffer .architecture-nodes {
    grid-template-columns: 1fr;
  }
  .architecture-layer-buffer .architecture-node {
    border-left: 3px solid var(--ds-primary);
  }
  .architecture-flows {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--ds-border);
  }
  .architecture-flows p {
    margin: 6px 0;
    font-size: 11px;
    line-height: 1.8;
    color: var(--ds-text-muted);
    overflow-wrap: anywhere;
  }
  .architecture-flows span {
    display: inline-block;
    margin-right: 10px;
    color: var(--ds-text);
    font-weight: 550;
  }
  .architecture-benefits {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: 12px 0;
  }
  .architecture-benefits article {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--ds-border);
  }
  .architecture-benefit-icon {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--ds-selection);
    color: var(--ds-selection-foreground);
  }
  .architecture-benefits h3 {
    margin: 13px 0 8px;
    font-size: 18px;
    font-weight: 550;
    line-height: 1.5;
  }
  .architecture-benefits p {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: 14px;
    line-height: 1.75;
  }
  .architecture-deploy-link {
    margin-top: auto;
  }
  .architecture-benchmark {
    margin-top: 32px;
    padding: 28px;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-lg);
    background: var(--ds-surface);
  }
  .architecture-benchmark-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .architecture-benchmark-header h3 {
    margin: 12px 0 0;
    font-size: 24px;
    font-weight: 550;
    letter-spacing: -0.025em;
  }
  .architecture-status {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background: var(--ds-warning-soft);
    color: var(--ds-text);
    font-size: 12px;
    border: 1px solid var(--ds-border);
  }
  .architecture-status[data-passed="true"] {
    background: var(--ds-success-soft);
  }
  .architecture-hardware {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 0 0 20px;
    color: var(--ds-text);
    font-size: 13px;
    line-height: 1.7;
  }
  .architecture-hardware strong {
    font-weight: 550;
  }
  .architecture-hardware span {
    color: var(--ds-text-muted);
  }
  .architecture-benchmark-context {
    margin: 16px 0 24px;
    color: var(--ds-text-muted);
    font-size: 12px;
    line-height: 1.75;
  }
  .architecture-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding-block: 24px;
    border-block: 1px solid var(--ds-border);
  }
  .architecture-metrics > div {
    min-width: 0;
    padding-inline: 22px;
    border-right: 1px solid var(--ds-border);
  }
  .architecture-metrics > div:first-child {
    padding-left: 0;
  }
  .architecture-metrics > div:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .architecture-metrics dt {
    font-size: 13px;
    color: var(--ds-text-secondary);
  }
  .architecture-metrics dd {
    margin: 14px 0 0;
    font-size: clamp(25px, 2.6vw, 34px);
    line-height: 1.2;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
  .architecture-metrics small {
    margin-left: 6px;
    font-size: 12px;
    font-weight: 400;
    color: var(--ds-text-muted);
    letter-spacing: 0;
  }
  .architecture-metrics p {
    margin: 10px 0 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--ds-text-muted);
  }
  .architecture-benchmark-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    margin-top: 20px;
  }
  .architecture-benchmark-footer p {
    max-width: 740px;
    margin: 0;
    font-size: 12px;
    line-height: 1.8;
    color: var(--ds-text-muted);
  }
  .architecture-benchmark-footer strong {
    color: var(--ds-text);
    font-weight: 550;
  }
  .architecture-benchmark-footer a {
    flex-shrink: 0;
  }
  .architecture-benchmark-note {
    margin: 16px 0 0;
    font-size: 11px;
    line-height: 1.7;
    color: var(--ds-text-muted);
  }
  @media (max-width: 1050px) {
    .architecture-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .architecture-benefits {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .architecture-deploy-link {
      grid-column: 1 / -1;
    }
    .architecture-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 0;
    }
    .architecture-metrics > div:nth-child(2) {
      border-right: 0;
    }
    .architecture-metrics > div:nth-child(3) {
      padding-left: 0;
    }
  }
  @media (max-width: 650px) {
    .architecture-section {
      padding-block: 56px;
    }
    .architecture-heading {
      display: block;
    }
    .architecture-intro {
      margin-top: 24px;
      max-width: none;
    }
    .architecture-diagram {
      padding: 16px;
    }
    .architecture-layer {
      grid-template-columns: minmax(0, 1fr);
    }
    .architecture-layer-label {
      padding-bottom: 3px;
    }
    .architecture-node {
      padding: 9px;
    }
    .architecture-benefits {
      grid-template-columns: 1fr;
    }
    .architecture-benchmark {
      padding: 20px;
    }
    .architecture-benchmark-header,
    .architecture-benchmark-footer {
      display: block;
    }
    .architecture-status {
      display: inline-block;
      margin-top: 16px;
    }
    .architecture-benchmark-header h3 {
      font-size: 21px;
    }
    .architecture-metrics > div {
      padding-inline: 12px;
    }
    .architecture-metrics dd {
      font-size: 25px;
    }
    .architecture-metrics small {
      display: block;
      margin: 5px 0 0;
    }
    .architecture-benchmark-footer a {
      margin-top: 12px;
    }
  }
</style>
