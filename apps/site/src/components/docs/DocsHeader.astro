---
import Search from "@astrojs/starlight/components/Search.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import BrandMark from "../BrandMark.astro";
import { topics } from "../../lib/docsTopics";
import DocsLanguageMenu from "./DocsLanguageMenu.astro";
import DocsThemeMenu from "./DocsThemeMenu.astro";
import PaletteMenu from "../PaletteMenu.astro";

const route = Astro.locals.starlightRoute;
const zh = Astro.url.pathname.startsWith("/zh/");
const prefix = zh ? "/zh" : "";
const tabs = topics(route.sidebar);
---

<div class="docs-header">
  <a class="site-brand docs-brand" href={`${prefix}/`} aria-label="Docs">
    <span class="brand-mark" aria-hidden="true"><BrandMark /></span>
    <span class="docs-wordmark">Docs</span>
  </a>

  <nav class="docs-tabs" aria-label={zh ? "文档分类" : "Documentation sections"}>
    {
      tabs.map((tab) => (
        <a href={tab.href} aria-current={tab.isCurrent ? "true" : undefined}>
          {tab.label}
        </a>
      ))
    }
  </nav>

  <div class="docs-header-search print:hidden"><Search /></div>

  <div class="docs-header-actions print:hidden">
    <div class="docs-header-icons sl-flex"><SocialIcons /></div>
    <PaletteMenu lang={zh ? "zh" : "en"} />
    <DocsThemeMenu />
    <DocsLanguageMenu />
  </div>
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
    min-width: 0;
  }
  .docs-brand {
    flex-shrink: 0;
    gap: 0.375rem;
    font-size: 1.25rem;
  }
  .docs-wordmark {
    color: var(--ds-text);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  /* Four tabs fit at desktop widths; below that the row scrolls rather than wrapping,
     which would change the header height and cost layout stability. */
  .docs-tabs {
    display: flex;
    gap: 1.25rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .docs-tabs::-webkit-scrollbar {
    display: none;
  }
  .docs-tabs a {
    position: relative;
    padding: 0.35rem 0;
    color: var(--ds-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 550;
    white-space: nowrap;
  }
  .docs-tabs a:hover {
    color: var(--ds-text);
  }
  .docs-tabs a[aria-current] {
    color: var(--ds-text);
  }
  .docs-tabs a[aria-current]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -0.6rem;
    height: 2px;
    border-radius: 2px;
    background: var(--ds-primary);
  }

  .docs-header-search {
    flex: 1;
    min-width: 0;
    margin-inline-start: auto;
  }
  .docs-header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .docs-header-icons {
    align-items: center;
    gap: 0.5rem;
  }

  /* Starlight owns the mobile menu below this width and the tabs would crowd out the
     search field, so they move into the sidebar drawer instead. */
  @media (max-width: 72rem) {
    .docs-tabs {
      display: none;
    }
  }
</style>
