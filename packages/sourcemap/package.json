{
  "name": "@openrum/sourcemap",
  "version": "0.1.0",
  "description": "Upload private Source Maps from a build to an OpenRUM Release, as a library or a Vite plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-rum/openrum.git",
    "directory": "packages/sourcemap"
  },
  "bugs": {
    "url": "https://github.com/open-rum/openrum/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
