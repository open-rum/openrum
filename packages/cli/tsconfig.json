{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@openrum/sourcemap": ["../sourcemap/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
