{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@openrum/protocol": ["../protocol/src/index.ts"],
      "@openrum/protocol/dsn": ["../protocol/src/dsn.ts"]
    }
  },
  "include": ["src", "test"]
}
